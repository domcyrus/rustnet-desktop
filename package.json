{
  "name": "rustnet-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "bundle": "tauri build",
    "desktop:linux-compat": "env WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "test:engine-source": "node --test scripts/engine-source.check.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.2",
    "lucide-react": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.12.0"
}
