{
  "name": "rustnet-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "bundle": "tauri build",
    "desktop:linux-compat": "env WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "test:engine-source": "node --test scripts/engine-source.check.mjs",
    "check:engine": "node scripts/check-engine.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.12.0"
}
