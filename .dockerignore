# Send only build inputs, not the checkout, host caches or credentials.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!index.html
!tsconfig.json
!vite.config.ts
!vitest.config.ts
!engine.lock.json
!src/
!src/**
!public/
!public/**
!scripts/
!scripts/*.mjs
!engine/
!engine/patches/
!engine/patches/*.patch
!src-tauri/
!src-tauri/Cargo.toml
!src-tauri/Cargo.lock
!src-tauri/build.rs
!src-tauri/tauri.conf.json
!src-tauri/src/
!src-tauri/src/**
!src-tauri/capabilities/
!src-tauri/capabilities/**
!src-tauri/icons/
!src-tauri/icons/**
!src-tauri/macos/
!src-tauri/macos/**
# Exclude common secrets even within an allowed source directory.
**/.git
**/.env*
**/.npmrc
**/.netrc
**/credentials
**/credentials.toml
**/*.pem
**/*.key
