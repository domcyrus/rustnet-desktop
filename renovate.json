{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Zurich",
  "enabledManagers": ["npm", "cargo", "github-actions"],
  "ignorePaths": ["**/node_modules/**", "**/target/**", "**/dist/**", ".engine/**", ".migration-backup/**", "engine/patches/**"],
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Group routine frontend updates; review major upgrades separately.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend dependencies"
    },
    {
      "description": "Group compatible Rust updates, including their lockfile changes.",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust dependencies"
    },
    {
      "description": "Keep routine Tauri JavaScript and Rust updates in one PR.",
      "matchManagers": ["npm", "cargo"],
      "matchPackageNames": ["@tauri-apps/*", "tauri", "tauri-build", "tauri-plugin-*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Tauri dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "groupName": "GitHub Actions"
    }
  ]
}
